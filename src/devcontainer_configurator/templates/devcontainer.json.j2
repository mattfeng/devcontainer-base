{
  "name": "Claude Code/Codex/Pi Sandbox",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "TZ": "${localEnv:TZ:America/New_York}",
      "CLAUDE_CODE_VERSION": "latest",
      "CODEX_CLI_VERSION": "latest",
      "PI_CODING_AGENT_VERSION": "latest",
      "YARN_MODERN_VERSION": "4",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.0"
    }
  },
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_CHROOT",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    "--add-host=host.docker.internal:host-gateway"{% if gpu.mode == "all" %},
    "--gpus=all"{% elif gpu.mode == "device" %},
    {{ ("--gpus=device=" ~ gpu.device) | tojson }}{% endif %}
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        }
      }
    }
  },
  "remoteUser": "node",
  "mounts": [
    "source=claude-code-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=codex-config-${devcontainerId},target=/home/node/.codex,type=volume",
    "source=pi-config-${devcontainerId},target=/home/node/.pi,type=volume"{% for mount in reference_mounts %},
    {{ (
      "source=" ~ mount.source ~ ",target=" ~ mount.target ~ ",type=bind,readonly"
    ) | tojson }}{% endfor %}{% for path in masked_paths %},
    {{ (
      "source=${localWorkspaceFolder}/.devcontainer/" ~ masked_file_placeholder
      ~ ",target=/workspace/${localWorkspaceFolderBasename}/" ~ path
      ~ ",type=bind,readonly"
      if path in masked_file_paths
      else "target=/workspace/${localWorkspaceFolderBasename}/" ~ path
      ~ ",type=volume,volume-nocopy"
    ) | tojson }}{% endfor %}{% for path in read_only_paths %},
    {{ (
      "source=${localWorkspaceFolder}/" ~ path
      ~ ",target=/workspace/${localWorkspaceFolderBasename}/" ~ path
      ~ ",type=bind,readonly"
    ) | tojson }}{% endfor %}
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    "CODEX_HOME": "/home/node/.codex",
    "PI_CODING_AGENT_DIR": "/home/node/.pi/agent",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "DEVCONTAINER_HOST_PORTS": {{ host_ports | tojson }}{% if git_read_only %},
    "GIT_OPTIONAL_LOCKS": "0"{% endif %}
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/${localWorkspaceFolderBasename},type=bind,consistency=delegated",
  "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",
  "postStartCommand": "sudo DEVCONTAINER_HOST_PORTS=\"${DEVCONTAINER_HOST_PORTS:-}\" /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
